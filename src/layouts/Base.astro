---
import "../styles/global.css";
import fontUrl from "../assets/fonts/Diatype.woff2?url";
import condensedUrl from "../assets/fonts/DiatypeCondensed.woff2?url";

interface Props {
	title?: string;
	// What a search engine shows under the title, and what a link preview says. One or two
	// plain sentences about this page. A page without one gets the site's line.
	description?: string;
	// Keeps a page out of search engines. For the temporary pages that hold placeholder text.
	noindex?: boolean;
}

const SITE_NAME = "Love&Hate AI";
// Only until the owner writes the homepage statement. See the plan, item 1.
const SITE_DESCRIPTION = "Love&Hate AI is a newsletter site for designers: articles, inspos and AI skills.";

const { title = SITE_NAME, description = SITE_DESCRIPTION, noindex = false } = Astro.props;

// Absolute addresses need the site's own URL, which is `site` in astro.config.mjs. Until
// it is set there is no honest absolute address to give, so the canonical link and the
// Open Graph address are left out, and the tags that don't need one still go out.
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<!-- The poster's clips and pictures are linked from their own servers. The video CDN
		     refuses a request that names another site as the referrer, and a <video> has no
		     per-element switch like an image's referrerpolicy, so the page sends none. -->
		<meta name="referrer" content="no-referrer" />
		<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#191919" media="(prefers-color-scheme: dark)" />
		<link rel="preload" href={fontUrl} as="font" type="font/woff2" crossorigin />
		<!-- Every page's h1 is set in the condensed cut, and it is on the first screen. -->
		<link rel="preload" href={condensedUrl} as="font" type="font/woff2" crossorigin />
		<title>{title}</title>
		<meta name="description" content={description} />
		{noindex && <meta name="robots" content="noindex" />}
		{canonical && <link rel="canonical" href={canonical} />}
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={SITE_NAME} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		{canonical && <meta property="og:url" content={canonical} />}
		<!-- No og:image. The site has no image of its own, and one made up for the purpose
		     would be decoration. Until there is one, a link preview is text only. -->
		<meta name="twitter:card" content="summary" />
		{Astro.site && <link rel="sitemap" href="/sitemap.xml" />}
	</head>
	<body>
		<slot />
	</body>
</html>
