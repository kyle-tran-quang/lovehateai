---
import "../styles/global.css";
import fontUrl from "../assets/fonts/Diatype.woff2?url";
import condensedUrl from "../assets/fonts/DiatypeCondensed.woff2?url";

interface Props {
	title?: string;
	// Preload the condensed cut only on pages whose first screen uses it.
	condensed?: boolean;
}

const { title = "Love&Hate AI", condensed = false } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#191919" media="(prefers-color-scheme: dark)" />
		<link rel="preload" href={fontUrl} as="font" type="font/woff2" crossorigin />
		{condensed && <link rel="preload" href={condensedUrl} as="font" type="font/woff2" crossorigin />}
		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>
