---
// The inspos library: every inspo, newest first, grouped by month, with a search field
// and a filter by type. The homepage shows the newest three. This page shows all of them.
//
// The search, the type filter and their script are in Library, shared with /skills/ and
// /news/. Each picture is the poster's own, linked from their post and never copied here.
// The picture and the title both go to that post, except an inspo with a recipe: those go
// to its sheet (RecipeSheet), which slides in over this page and links to the post.
// Without JS it is one long list, and the sheets are plain sections after it.
//
// A figure is only its picture. Where there is a hover, the title, credit and date show in
// a bar on the picture's bottom edge while the pointer or keyboard focus is on the figure.
// On touch there is no hover, so the same text sits under the picture instead.
import { getCollection, render } from "astro:content";
import Base from "../layouts/Base.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import ExtLink from "../components/ExtLink.astro";
import Library from "../components/Library.astro";
import Pic from "../components/Pic.astro";
import RecipeSheet from "../components/RecipeSheet.astro";
import { byDateDesc, formatDayMonth, isoDate, keep, slug } from "../lib/content";
import { siteNav } from "../lib/nav";

// Newest first. Entries on the same day keep a fixed order, so a rebuild never shuffles them.
const inspos = (await getCollection("inspos", keep)).sort(
	(a, b) => byDateDesc(a, b) || a.id.localeCompare(b.id),
);

// Each recipe's Markdown, rendered once here and handed to its sheet.
const recipes = await Promise.all(
	inspos
		.filter((e) => e.body?.trim())
		.map(async (entry) => ({ entry, Body: (await render(entry)).Content })),
);

const types = [...new Set(inspos.map((e) => e.data.type))]
	.sort((a, b) => a.localeCompare(b))
	.map((name) => ({ id: slug(name), name }));

// Months, newest first. Dates are plain days in UTC, so the month is read in UTC too.
const monthName = new Intl.DateTimeFormat("en-GB", { month: "long", year: "numeric", timeZone: "UTC" });
const months = [...Map.groupBy(inspos, (e) => isoDate(e.data.date).slice(0, 7))].map(([key, items]) => ({
	id: `m-${key}`,
	name: monthName.format(items[0].data.date),
	items,
}));
---

<Base
	title="Inspos | Love&Hate AI"
	description="Design work other people posted, newest first, with guides to making something like it. Search by what it is or how it was made."
>
	<SiteHeader links={siteNav} rule="right" />

	<main id="main">
		<Library title="Inspos" noun="inspos" search="Search inspos" filterName="type" filters={types} from={5} air={3}>
			<Fragment slot="intro">
				<p class="lead">Design work other people posted and we kept.</p>
				<p class="muted">
					Every entry links to the original post, and the picture comes from that post. Where the post is a video, the
					picture is its first frame and the clip plays on a loop while it is on screen. Open the entry for the player, with controls. The credit goes to whoever made it. An entry marked
					"How to recreate it" opens a guide first: what is on screen, how it looks to be built, and a way to get close,
					worked out from the post and not tested. The guide links to the post.
				</p>
			</Fragment>

			{
				months.map((m) => (
					<section class="group" data-group aria-labelledby={`${m.id}-title`}>
						<hr />
						<h2 class="title" id={`${m.id}-title`}>{m.name}</h2>
						<ul role="list" class="figs">
							{m.items.map((e) => (
								<li
									class="fig"
									data-item
									data-filter={slug(e.data.type)}
									data-text={`${e.data.title} ${e.data.credit} ${e.data.type} ${e.data.source} ${e.data.alt ?? ""} ${e.data.tool ?? ""} ${e.body ?? ""}`.toLowerCase()}
								>
									<figure>
										<div class="shot">
											<Pic
												ratio={[16, 10]}
												image={e.data.image}
												src={e.data.imageUrl}
												video={e.data.videoUrls?.[0]}
												alt={e.data.alt}
												href={e.body?.trim() ? `#recipe-${e.id}` : e.data.url}
												sizes="(min-width: 64rem) 22vw, 45vw"
											/>
										</div>
										<figcaption>
											<p class="name">
												{e.body?.trim() ? <a href={`#recipe-${e.id}`}>{e.data.title}</a> : <ExtLink href={e.data.url}>{e.data.title}</ExtLink>}
											</p>
											<p class="muted">
												{e.data.credit}, <time class="tnum" datetime={isoDate(e.data.date)}>{formatDayMonth(e.data.date)}</time>
											</p>
											{e.body?.trim() && <p class="muted">How to recreate it</p>}
										</figcaption>
									</figure>
								</li>
							))}
						</ul>
					</section>
				))
			}
		</Library>

		{
			recipes.map(({ entry, Body }) => (
				<RecipeSheet entry={entry}>
					<Body />
				</RecipeSheet>
			))
		}
	</main>

	<SiteFooter links={siteNav} />
</Base>

<style>
	/* Results. The search, the type filter and the layout around them are in Library.
	   A month is a rule and its title, then the figures. Spacing sits on the month, so
	   one that a filter hides leaves no gap behind. */
	.group {
		margin-top: calc(var(--line) * 3);
	}

	.group:first-of-type {
		margin-top: 0;
	}

	.group h2 {
		padding-block: calc(var(--line) * 0.75) calc(var(--line) * 1);
	}

	/* Two across, then three. The figures share the page's gutter. */
	.figs {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		column-gap: var(--gutter);
		row-gap: calc(var(--line) * 1.5);
	}

	figure {
		position: relative;
		display: grid;
		gap: calc(var(--line) * 0.5);
		align-content: start;
	}

	figcaption {
		overflow-wrap: anywhere;
	}

	figcaption p + p {
		margin-top: calc(var(--line) * 0.25);
	}

	/* The title underlines on hover, and while the pointer is on the picture, which goes
	   to the same place. Without a hover (touch) it keeps the underline, so it still
	   reads as a link. */
	.name a {
		text-decoration-line: none;
	}

	.name a:hover,
	.fig:has(.shot a:hover) .name a {
		text-decoration-line: underline;
	}

	@media (hover: none) {
		.name a {
			text-decoration-line: underline;
		}
	}

	[hidden] {
		display: none !important;
	}

	@media (min-width: 64rem) {
		.figs {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}

	/* With a hover, the figure is only its picture, and the text is a plain rectangle on the
	   picture's bottom edge: the page ground, a 1px rule on top, no radius, no shadow, no
	   blur. It shows while the pointer is on the figure or keyboard focus is inside it.
	   The text stays in the page at all times, so screen readers read it, and the title
	   link stays focusable while the bar is hidden, which is what brings the bar up.
	   The bar lets the pointer through, except on the link itself, so a click anywhere on
	   the figure still opens the post. */
	@media (hover: hover) {
		.figs {
			row-gap: var(--gutter);
		}

		figure {
			display: block;
		}

		figcaption {
			position: absolute;
			inset-inline: 0;
			bottom: 0;
			padding: calc(var(--line) * 0.5) calc(var(--line) * 0.6) calc(var(--line) * 0.6);
			background: var(--page);
			border-top: 1px solid var(--rule);
			opacity: 0;
			transform: translateY(0.4rem);
			pointer-events: none;
		}

		figcaption :global(a) {
			pointer-events: auto;
		}

		.fig:hover figcaption,
		.fig:has(:focus-visible) figcaption {
			opacity: 1;
			transform: none;
		}
	}

	@media (hover: hover) and (prefers-reduced-motion: no-preference) {
		figcaption {
			transition:
				opacity 180ms ease-out,
				transform 180ms ease-out;
		}
	}
</style>
