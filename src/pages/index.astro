---
import { getCollection, render } from "astro:content";
import Base from "../layouts/Base.astro";
import SiteHeader from "../components/SiteHeader.astro";
import Section from "../components/Section.astro";
import Pic from "../components/Pic.astro";
import ExtLink from "../components/ExtLink.astro";
import SiteFooter from "../components/SiteFooter.astro";
import NewsRows from "../components/NewsRows.astro";
import { keep, byDateDesc, formatDate, formatDayMonth, isoDate, isExternal } from "../lib/content";

// News: the newest entry flagged `featured`, else the newest entry, is the hero.
// The list below shows the rest.
const allNews = (await getCollection("news", keep)).sort(byDateDesc);
const featured = allNews.find((e) => e.data.featured) ?? allNews[0];
const news = allNews.filter((e) => e !== featured).slice(0, 6);

// An entry's Markdown body is the owner's own note. Render it only when there is one.
// The rows below render their own notes, in NewsRows.
const FeaturedNote = featured?.body?.trim() ? (await render(featured)).Content : undefined;

const allInspos = (await getCollection("inspos", keep)).sort(byDateDesc);
const inspos = allInspos.slice(0, 3);
const [widePic, ...smallPics] = inspos;

// The homepage lists the skills flagged `home`. /skills/ has all of them.
const allSkills = await getCollection("skills", keep);
const skills = allSkills
	.filter((s) => s.data.home)
	.sort((a, b) => a.data.group.localeCompare(b.data.group) || a.data.name.localeCompare(b.data.name));
const skillGroups = [...Map.groupBy(skills, (s) => s.data.group)].map(([name, items]) => ({ name, items }));

// Cheat sheets are hidden for now. Set this to true to bring the section, its header
// and footer links and its row in the hero's list back. The content and the CMS
// collection stay as they are.
const SHOW_SHEETS = false;
const sheets = SHOW_SHEETS ? (await getCollection("cheatsheets", keep)).sort(byDateDesc) : [];
// Quotes: one at a time, picked by UTC day number, so it rotates daily. The site is
// static, so the pick is fixed at build time: it only changes when the site is rebuilt.
const allQuotes = (await getCollection("quotes", keep)).sort((a, b) => a.id.localeCompare(b.id));
const quote = allQuotes.length
	? allQuotes[Math.floor(Date.now() / 86_400_000) % allQuotes.length]
	: undefined;

// A section with no entries isn't rendered, and has no link in the header or footer.
const navLinks = [
	{ href: "#news", label: "News", count: news.length },
	{ href: "#inspos", label: "Inspos", count: inspos.length },
	{ href: "#skills", label: "AI skills", count: skills.length },
	{ href: "#sheets", label: "Cheat sheets", count: sheets.length },
	{ href: "#quotes", label: "Quotes", count: quote ? 1 : 0 },
].filter((s) => s.count > 0);

// The hero's list: the newest entry of each section, linking out to it. Skills have no
// date, so there is no newest one to name.
const latest = [
	news[0] && { label: "News", text: news[0].data.title, url: news[0].data.url },
	inspos[0] && { label: "Inspos", text: inspos[0].data.title, url: inspos[0].data.url },
	sheets[0] && { label: "Cheat sheets", text: sheets[0].data.title, url: sheets[0].data.url },
	quote && { label: "Quotes", text: quote.data.name, url: quote.data.url },
].filter((row) => row !== undefined);
---

<Base>
	<SiteHeader links={navLinks} sticky />

	<main id="main">
		{
			featured ? (
				<>
					<section class="grid hero" aria-labelledby="featured-title">
						<h1 id="featured-title">
							<a href={featured.data.url}>{featured.data.headline ?? featured.data.title}</a>
						</h1>
						<div class="meta">
							<p class="stack muted tnum">
								<time datetime={isoDate(featured.data.date)}>{formatDate(featured.data.date)}</time>
								<span>{featured.data.source}</span>
								<span>{featured.data.author}</span>
								{featured.data.topic && <span>{featured.data.topic}</span>}
							</p>
							<p>
								<ExtLink href={featured.data.url}>Read at {featured.data.source}</ExtLink>
							</p>
						</div>
						{FeaturedNote && (
							<div class="prose note">
								<FeaturedNote />
							</div>
						)}
						<div class="shot">
							<Pic
								ratio={[4, 3]}
								image={featured.data.image}
								src={featured.data.imageUrl}
								alt={featured.data.alt}
								label="no image yet"
								sizes="(min-width: 64rem) 30vw, 100vw"
								eager
								href={featured.data.url}
							/>
						</div>
						{latest.length > 0 && (
							<ul role="list" class="latest" aria-label="Latest from each section">
								{latest.map((row) => (
									<li>
										<span class="muted">{row.label}</span>
										{isExternal(row.url) ? <ExtLink href={row.url}>{row.text}</ExtLink> : <a href={row.url}>{row.text}</a>}
									</li>
								))}
							</ul>
						)}
					</section>
				</>
			) : (
				<section class="grid hero">
					<h1>Love&amp;Hate AI</h1>
				</section>
			)
		}

		{
			news.length > 0 && (
				<Section id="news" title="News">
					<NewsRows entries={news} />
					{allNews.length > news.length + 1 && (
						<p class="all">
							<a href="/news/">View more news</a>
							<span aria-hidden="true">&nbsp;→</span>
						</p>
					)}
				</Section>
			)
		}

		{
			inspos.length > 0 && (
				<Section id="inspos" title="Latest inspos">
					<div class="inspos">
						{[widePic, ...smallPics].map((e, i) => {
							return (
								<figure class={i === 0 ? "wide" : "small"}>
									<Pic
										ratio={i === 0 ? [16, 10] : [4, 3]}
										image={e.data.image}
										src={e.data.imageUrl}
										alt={e.data.alt}
										label={i === 0 ? "no image yet" : undefined}
										small={i > 0}
										sizes={i === 0 ? "(min-width: 64rem) 45vw, 100vw" : "(min-width: 64rem) 15vw, 50vw"}
									/>
									<figcaption>
										<p>
											<ExtLink href={e.data.url}>{e.data.title}</ExtLink>
										</p>
										<p class="muted stack">
											<span>Credit: {e.data.credit}</span>
											<span>
												Source: {e.data.source}, <time datetime={isoDate(e.data.date)}>{formatDate(e.data.date)}</time>
											</span>
										</p>
									</figcaption>
								</figure>
							);
						})}
					</div>
					{allInspos.length > inspos.length && (
						<p class="all">
							<a href="/inspos/">View all inspos</a>
							<span aria-hidden="true">&nbsp;→</span>
						</p>
					)}
				</Section>
			)
		}

		{
			skills.length > 0 && (
				<Section id="skills" title="AI skills">
					<div class="groups">
						{skillGroups.map((g) => (
							<div class="group">
								<h3>{g.name}</h3>
								<ul role="list" class="muted">
									{g.items.map((s) => (
										<li>
											<ExtLink href={s.data.url}>{s.data.name}</ExtLink>
											<br />
											{s.data.summary}
										</li>
									))}
								</ul>
							</div>
						))}
					</div>
					{allSkills.length > skills.length && (
						<p class="all">
							<a href="/skills/">View skills library</a>
							<span aria-hidden="true">&nbsp;→</span>
						</p>
					)}
				</Section>
			)
		}

		{
			sheets.length > 0 && (
				<Section id="sheets" title="Cheat sheets">
					<ul role="list" class="rows">
						{sheets.map((s) => (
							<li class="row sheet">
								<time class="muted tnum" datetime={isoDate(s.data.date)}>{formatDayMonth(s.data.date)}</time>
								<div class="thumb">
									<Pic ratio={[4, 3]} image={s.data.image} alt={s.data.alt} small href={s.data.url} />
								</div>
								<div>
									<h3 class="title">
										{isExternal(s.data.url) ? (
											<ExtLink href={s.data.url}>{s.data.title}</ExtLink>
										) : (
											<a href={s.data.url}>{s.data.title}</a>
										)}
									</h3>
									<p class="muted by">{s.data.summary}</p>
								</div>
							</li>
						))}
					</ul>
				</Section>
			)
		}

		{
			quote && (
				<Section id="quotes" title="Quotes">
					<figure class="quote">
						<blockquote class="title">
							<p>“{quote.data.quote}”</p>
						</blockquote>
						<figcaption class="muted">
							{quote.data.name}, <ExtLink href={quote.data.url}>{quote.data.source}</ExtLink>
						</figcaption>
					</figure>
				</Section>
			)
		}
	</main>

	<SiteFooter links={navLinks} />
</Base>

<style>
	main {
		padding-bottom: calc(var(--line) * 7);
	}

	/* Hero. Display headline over a row of meta, note and contents.
	   Phones: one column in reading order. */
	.hero {
		padding-top: calc(var(--line) * 3);
		row-gap: calc(var(--line) * 1.5);
	}

	.shot {
		justify-self: end;
		width: 100%;
		max-width: 30rem;
	}

	/* The headline and the picture both open the story. The headline is underlined while
	   the pointer is on it or on the picture. Touch screens get no underline: the
	   "Read at" link beside the headline is the visible link there. The picture's link
	   is rendered by Pic, so it is matched with :global. */
	.hero h1 a {
		text-decoration-line: none;
	}

	.hero h1 a:hover,
	.hero:has(.shot :global(a:hover)) h1 a {
		text-decoration-line: underline;
	}

	/* Smooth scrolling for the header links, and the footer's way back up. Not for anyone
	   who asked for less motion. The sticky bar (from 48rem) is about 3 lines tall, so a
	   jump lands the section's rule just under it. */
	@media (prefers-reduced-motion: no-preference) {
		:global(html) {
			scroll-behavior: smooth;
		}
	}

	@media (min-width: 48rem) {
		:global(html) {
			scroll-padding-top: calc(var(--line) * 3 + 1px);
		}
	}

	/* The hero's list: a label and the newest entry of that section, ruled like the
	   masthead's label/value list. */
	.latest li {
		display: grid;
		grid-template-columns: 6.5rem minmax(0, 1fr);
		column-gap: var(--gutter);
		padding-block: calc(var(--line) * 0.4);
		border-top: 1px solid var(--rule);
	}

	.latest li:last-child {
		border-bottom: 1px solid var(--rule);
	}

	/* Phones. The hero is tighter, and the image is a little narrower than the text
	   column so it reads as a figure, not a banner. */
	@media (max-width: 47.999rem) {
		.hero {
			padding-top: calc(var(--line) * 2);
			row-gap: var(--line);
		}

		.shot {
			max-width: none;
		}

		/* Sheet rows: the date on the left, the title and summary beside it, and the
		   thumbnail last, under the text in the second column. The thumbnail comes
		   second in the markup, so move it down explicitly. */
		.sheet > :nth-child(1) {
			grid-column: 1;
			grid-row: 1;
		}

		.sheet > :nth-child(2) {
			grid-column: 2;
			grid-row: 2;
		}

		.sheet > :nth-child(3) {
			grid-column: 2;
			grid-row: 1;
		}
	}

	@media (min-width: 48rem) {
		.hero {
			padding-top: calc(var(--line) * 5);
		}

		h1 {
			grid-column: 1 / -1;
		}

		.meta {
			grid-column: 1 / span 4;
		}

		.note {
			grid-column: 5 / span 8;
		}

		.shot,
		.latest {
			grid-column: 5 / span 8;
		}
	}

	/* Masthead mapping: text starts in column 2 of six (column 3 of twelve),
	   the list takes the last two (9-12). */
	@media (min-width: 64rem) {
		/* The meta and note sit on the bottom edge of the row, level with the
		   bottom of the image beside them. */
		.meta {
			grid-column: 1 / span 2;
			align-self: end;
		}

		.note {
			grid-column: 3 / span 4;
			align-self: end;
		}

		.shot,
		.latest {
			grid-column: 9 / span 4;
		}
	}

	@media (min-width: 48rem) {
		.quote {
			grid-column: 1 / span 6;
		}

		.sheet > :nth-child(1) {
			grid-column: 1 / span 1;
		}

		.sheet > :nth-child(2) {
			grid-column: 2 / span 2;
		}

		.sheet > :nth-child(3) {
			grid-column: 4 / -1;
		}
	}

	/* The section title sits 0.75 line below the rule. The quote starts level with it. */
	.quote {
		padding-top: calc(var(--line) * 0.75);
	}

	/* Inspos. One wide figure and up to two small ones. */
	.inspos {
		grid-column: 1 / -1;
		display: grid;
		grid-template-columns: subgrid;
		row-gap: calc(var(--line) * 1.5);
		padding-top: calc(var(--line) * 0.75);
	}

	/* Phones, as in the index list reference: the wide image on top, and the two small
	   figures side by side under it, each with its caption. */
	@media (max-width: 47.999rem) {
		.inspos {
			grid-template-columns: 1fr 1fr;
			column-gap: var(--gutter);
			row-gap: var(--line);
		}

		.wide {
			grid-column: 1 / -1;
		}

		.small {
			grid-column: span 1;
		}

		.small figcaption {
			overflow-wrap: anywhere;
		}
	}

	figure {
		display: grid;
		grid-template-rows: auto 1fr;
		gap: calc(var(--line) * 0.5);
		align-content: start;
	}

	figcaption p + p {
		margin-top: calc(var(--line) * 0.25);
	}

	@media (min-width: 48rem) {
		.wide {
			grid-column: 1 / -1;
		}

		.small {
			grid-column: span 4;
		}
	}

	@media (min-width: 64rem) {
		.wide {
			grid-column: 1 / span 6;
			grid-row: 1 / span 2;
		}

		.small {
			grid-column: 7 / span 2;
		}
	}

	/* Skills. Group name in the text color, entries muted. */
	.groups {
		grid-column: 1 / -1;
		display: grid;
		grid-template-columns: subgrid;
		row-gap: calc(var(--line) * 3);
		padding-top: calc(var(--line) * 0.75);
	}

	.group {
		grid-column: 1 / -1;
	}

	/* The type, then its skills a line below it. */
	.group h3 {
		margin-bottom: var(--line);
	}

	.group li + li {
		margin-top: calc(var(--line) * 0.9);
	}

	@media (min-width: 48rem) {
		/* A group takes four columns and keeps two gutters of air on its right, so
		   neighbouring groups don't read as one block. The column starts stay on the grid. */
		.group {
			grid-column: span 4;
			padding-inline-end: calc(var(--gutter) * 2);
		}
	}

	.all {
		grid-column: 1 / -1;
		margin-top: calc(var(--line) * 1.5);
	}
</style>
