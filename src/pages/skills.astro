---
// The AI skills library: every skill, with a search field and a filter by type.
// The homepage shows the entries flagged `home`. This page shows all of them.
//
// The search, the type filter and their script are in Library, shared with /news/. The
// list is plain HTML: without JS it reads as one long list, grouped by type.
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import ExtLink from "../components/ExtLink.astro";
import Library from "../components/Library.astro";
import { keep, slug, sourceOf } from "../lib/content";

const skills = (await getCollection("skills", keep)).sort(
	(a, b) => a.data.group.localeCompare(b.data.group) || a.data.name.localeCompare(b.data.name),
);

// Types in the order they sort, each with its skills.
const groups = [...Map.groupBy(skills, (s) => s.data.group)].map(([name, items]) => ({
	name,
	id: slug(name),
	items,
}));

const nav = [{ href: "/", label: "Home" }];
---

<Base title="AI skills | Love&Hate AI">
	<SiteHeader links={nav} rule="right" />

	<main id="main">
		<Library
			title="AI skills"
			noun="skills"
			search="Search skills"
			filterName="type"
			filters={groups.map((g) => ({ id: g.id, name: g.name }))}
		>
			<Fragment slot="intro">
				<p class="lead">Instructions you install so an AI agent does design work better than it does by default.</p>
				<p class="muted">
					A skill is a folder an agent such as Claude Code loads when a task calls for it, like animating with GSAP or
					setting up design tokens. Each entry links to its source. Read what it tells the agent before you install it,
					because a skill is only as good as the opinions in it.
				</p>
			</Fragment>

			{
				groups.map((g) => (
					<section class="group" id={g.id} data-group aria-labelledby={`${g.id}-title`}>
						<hr />
						<h2 class="title" id={`${g.id}-title`}>{g.name}</h2>
						<ul role="list" class="list">
							{g.items.map((s) => (
								<li
									class="item"
									data-item
									data-filter={g.id}
									data-text={`${s.data.name} ${s.data.summary} ${g.name} ${sourceOf(s.data.url)}`.toLowerCase()}
								>
									<p class="name">
										<ExtLink href={s.data.url}>{s.data.name}</ExtLink>
										<span class="muted src">{sourceOf(s.data.url)}</span>
									</p>
									<p class="muted sum">{s.data.summary}</p>
								</li>
							))}
						</ul>
					</section>
				))
			}
		</Library>
	</main>

	<SiteFooter links={nav} />
</Base>

<style>
	/* Results. The search, the type filter and the layout around them are in Library. */
	.group {
		margin-top: calc(var(--line) * 2);
	}

	.group:first-of-type {
		margin-top: 0;
	}

	.group h2 {
		padding-block: calc(var(--line) * 0.75) calc(var(--line) * 0.25);
	}

	.item {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		row-gap: calc(var(--line) * 0.25);
		padding-block: calc(var(--line) * 0.75);
		border-top: 1px solid var(--rule);
	}

	.item:first-child {
		border-top: 0;
	}

	/* The source sits under the name, in gray, so a long owner/repo never runs into the arrow. */
	.src {
		display: block;
		overflow-wrap: anywhere;
	}

	/* Wide: name and source share one column, with the summary beside them. */
	@media (min-width: 64rem) {
		.item {
			grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
			column-gap: var(--gutter);
		}

		.item .sum {
			grid-column: 2;
			grid-row: 1;
		}
	}
</style>
