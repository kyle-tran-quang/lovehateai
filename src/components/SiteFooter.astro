---
// Mirrors the header: wordmark in column 1 with the credit under it, links from
// column 4 of the six (7 of the 12), the way back up at the right. Nothing else is
// claimed here until the owner decides what belongs in it (signup, legal line).
import ExtLink from "./ExtLink.astro";

interface Props {
	links: { href: string; label: string }[];
}

const { links } = Astro.props;
---

<footer class="grid foot">
	<hr />
	<div class="id">
		<p class="wordmark">Love&amp;Hate AI</p>
		<p>© by <ExtLink href="https://www.linkedin.com/in/kyletrandesign/">Kyle Tran</ExtLink>, 2026</p>
	</div>
	{
		links.length > 0 && (
			<nav aria-label="Footer">
				<ul role="list">
					{links.map((link) => (
						<li>
							<a href={link.href}>{link.label}</a>
						</li>
					))}
				</ul>
			</nav>
		)
	}
	<p class="top"><a href="#main">Back to top</a></p>
</footer>

<style>
	.foot {
		row-gap: var(--line);
		padding-bottom: calc(var(--line) * 3);
	}

	.foot hr {
		margin-bottom: calc(var(--line) * 0.25);
	}

	.wordmark {
		font-weight: 700;
	}

	/* Phones: links are at least 24px tall, and the list runs in two columns. */
	@media (max-width: 47.999rem) {
		nav ul {
			display: grid;
			grid-template-columns: 1fr 1fr;
			column-gap: var(--gutter);
		}

		nav a,
		.top a {
			display: inline-block;
			padding-block: 0.3rem;
		}
	}

	@media (min-width: 48rem) {
		hr {
			grid-column: 1 / -1;
		}

		.id {
			grid-column: 1 / span 4;
		}

		nav {
			grid-column: 5 / span 4;
		}

		.top {
			grid-column: 9 / -1;
			text-align: end;
		}
	}

	@media (min-width: 64rem) {
		.id {
			grid-column: 1 / span 2;
		}

		nav {
			grid-column: 7 / span 4;
		}

		.top {
			grid-column: 11 / -1;
		}
	}
</style>
