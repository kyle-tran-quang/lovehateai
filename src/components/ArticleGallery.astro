---
// One large image at a time, with small numbered thumbnails beneath it. The current
// thumbnail's number is inverted (text and ground swapped). All slides share one
// ratio and sit in one grid cell, so swapping never shifts the page.
//
// Without JS every figure shows, stacked, and the thumbnails stay hidden. The page
// script turns the stack into a single stage and unhides the thumbnails.
import Pic from "./Pic.astro";
import type { ImageMetadata } from "astro";

interface Props {
	// The figure number. Slides are numbered `3.1`, `3.2`.
	number: number;
	ratio: [number, number];
	slides: { caption: string; image?: ImageMetadata; alt?: string }[];
}

const { number, ratio, slides } = Astro.props;
---

<div class="gallery" data-gallery>
	<div class="stage">
		{
			slides.map((s, i) => (
				<figure data-slide data-zoom>
					<Pic ratio={ratio} image={s.image} alt={s.alt} label="no image yet" sizes="(min-width: 64rem) 33vw, 100vw" />
					<figcaption class="muted">
						<span class="mono tnum">
							figure {number}.{i + 1}
						</span>{" "}
						{s.caption}
					</figcaption>
				</figure>
			))
		}
	</div>
	<ul role="list" class="thumbs" data-thumbs hidden>
		{
			slides.map((s, i) => (
				<li>
					<button type="button" data-thumb aria-label={`Show figure ${number}.${i + 1}`}>
						<Pic ratio={ratio} image={s.image} alt="" small />
						<span class="chip mono tnum">{i + 1}</span>
					</button>
				</li>
			))
		}
	</ul>
</div>

<style>
	figure {
		margin: 0;
	}

	figcaption {
		margin-top: calc(var(--line) * 0.5);
	}

	/* One stage cell, all slides in it. The hidden ones keep their space, so the
	   tallest caption sets the height and nothing below moves. */
	.stage {
		display: grid;
	}

	.stage :global(figure[data-slide]) {
		grid-area: 1 / 1;
	}

	.stage :global(figure[data-slide]:not([data-current])) {
		visibility: hidden;
	}

	/* Before the script runs the slides stack as ordinary figures. */
	.gallery:not([data-ready]) .stage {
		display: block;
	}

	.gallery:not([data-ready]) figure + figure {
		margin-top: var(--line);
	}

	.thumbs {
		display: flex;
		gap: calc(var(--gutter) * 0.5);
		margin-top: calc(var(--line) * 0.75);
	}

	.thumbs[hidden] {
		display: none;
	}

	button {
		display: block;
		width: 4.5rem;
		padding: 0;
		border: 0;
		background: none;
		color: inherit;
		font: inherit;
		text-align: start;
		cursor: pointer;
	}

	.chip {
		display: inline-block;
		margin-top: calc(var(--line) * 0.25);
		padding-inline: 0.4em;
		border-radius: 4px;
	}

	button[aria-current] .chip {
		background: var(--text);
		color: var(--page);
	}
</style>
