---
// One lightbox for the page. A picture inside a `figure[data-zoom]` becomes a button
// (the script wraps it, so without JS it stays a plain image). Click it and the picture
// grows from where it sits to nearly the full window, then shrinks back on close.
//
// How it stays smooth: the enlarged copy is laid out once at its final size, and only
// its `transform` is animated, from the size and position of the original. Nothing
// reflows during the move and the image is never scaled up, so it stays sharp. The
// veil and the caption animate `opacity`. Both run on the compositor.
//
// Motion is 240ms in and 200ms out, on a strong ease-out. Reduced motion gets a short
// fade and no movement. Esc, a click anywhere, or the Close button closes it, and a
// close during the move reverses from wherever the picture is.
---

<dialog class="lightbox" data-lightbox aria-labelledby="lightbox-caption">
	<div class="veil" data-veil></div>
	<div class="stage" data-stage>
		<div data-slot></div>
		<div class="bar" data-bar>
			<p class="muted" id="lightbox-caption" data-caption></p>
			<button type="button" data-close>Close</button>
		</div>
	</div>
</dialog>

<style>
	.lightbox {
		position: fixed;
		inset: 0;
		width: 100%;
		height: 100%;
		max-width: none;
		max-height: none;
		margin: 0;
		padding: 0;
		border: 0;
		overflow: hidden;
		background: transparent;
		color: var(--text);
		cursor: zoom-out;
		overscroll-behavior: contain;
	}

	/* The page color fades in behind the picture instead of the browser's own dimmer, so
	   the ground stays a plain token color: no dimming, no blur. */
	.lightbox::backdrop {
		background: transparent;
	}

	.veil {
		position: absolute;
		inset: 0;
		background: var(--page);
	}

	/* The picture and its caption row sit together, centered in the window, one gutter
	   in from every edge. The script sizes the picture to fit the space above the row. */
	.stage {
		position: absolute;
		inset: var(--gutter);
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
	}

	.bar {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: var(--gutter);
		margin-top: calc(var(--line) * 0.5);
	}

	button {
		flex: none;
		padding: 0;
		border: 0;
		background: none;
		color: inherit;
		font: inherit;
		cursor: pointer;
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 0.18em;
	}

	/* Scroll lock while open. The gutter stays, so the page doesn't shift sideways when
	   the scrollbar goes. */
	:global(html.lightbox-open) {
		overflow: hidden;
		scrollbar-gutter: stable;
	}
</style>

<script>
	const OPEN_MS = 240;
	const CLOSE_MS = 200;
	// A strong ease-out: most of the distance is covered in the first third, so it reads
	// as quick, and it settles without a visible stop.
	const EASE = "cubic-bezier(0.32, 0.72, 0, 1)";

	const dialog = document.querySelector<HTMLDialogElement>("[data-lightbox]");

	if (dialog) {
		const veil = dialog.querySelector<HTMLElement>("[data-veil]")!;
		const stage = dialog.querySelector<HTMLElement>("[data-stage]")!;
		const slot = dialog.querySelector<HTMLElement>("[data-slot]")!;
		const bar = dialog.querySelector<HTMLElement>("[data-bar]")!;
		const caption = dialog.querySelector<HTMLElement>("[data-caption]")!;
		const reduced = matchMedia("(prefers-reduced-motion: reduce)");

		let trigger: HTMLElement | null = null;
		let source: HTMLElement | null = null; // the picture on the page
		let shown: HTMLElement | null = null; // its enlarged copy
		let ratio = 1;
		let closing = false;
		let running: Animation[] = [];

		// The placeholder's hairlines, dots and label. They are drawn in screen pixels, so
		// they don't survive being scaled. They fade in once the picture has landed and
		// fade out as it leaves, instead of shrinking with it.
		const chromeOf = (el: HTMLElement) => [...el.querySelectorAll<HTMLElement>(".frame, .label")];

		const run = (el: Element, keyframes: Keyframe[], options: KeyframeAnimationOptions) => {
			const a = el.animate(keyframes, { fill: "both", ...options });
			running.push(a);
			a.finished.catch(() => {}); // cancelled by a reversal
			return a;
		};

		// Size the copy to fill the stage above the caption row, at the picture's own
		// ratio. The slot, not the copy, is measured, because the copy may be mid-move.
		function fit() {
			if (!shown) return;
			const box = stage.getBoundingClientRect();
			const lineHeight = parseFloat(getComputedStyle(bar).lineHeight) || 18;
			// Room for two caption lines and the gap above them.
			const room = box.height - lineHeight * 3;
			const width = Math.max(0, Math.min(box.width, room * ratio));
			shown.style.width = `${width}px`;
			shown.style.height = `${width / ratio}px`;
			bar.style.width = `${width}px`;
		}

		const toSource = (from: DOMRect, to: DOMRect) =>
			`translate(${from.left - to.left}px, ${from.top - to.top}px) scale(${from.width / to.width}, ${from.height / to.height})`;

		function open(button: HTMLElement, figure: HTMLElement) {
			const pic = button.querySelector<HTMLElement>(".pic");
			if (!pic || dialog!.open) return;

			trigger = button;
			source = pic;
			const start = pic.getBoundingClientRect();
			ratio = start.width / start.height;

			shown = pic.cloneNode(true) as HTMLElement;
			shown.style.transformOrigin = "0 0";
			shown.style.flex = "none";
			const img = shown.querySelector("img");
			if (img) {
				// Draw at once, from what the page already loaded, and let the browser pick
				// a larger file for the bigger size when it has one.
				img.loading = "eager";
				img.decoding = "sync";
				img.sizes = "100vw";
			}
			slot.replaceChildren(shown);

			const note = figure.querySelector("figcaption");
			caption.replaceChildren(...(note ? [...note.cloneNode(true).childNodes] : []));

			document.documentElement.classList.add("lightbox-open");
			dialog!.showModal();
			fit();
			const end = slot.getBoundingClientRect();
			pic.style.visibility = "hidden";

			running = [];
			const chrome = chromeOf(shown);
			if (reduced.matches) {
				const fade = { duration: 150, easing: "linear" };
				run(veil, [{ opacity: 0 }, { opacity: 1 }], fade);
				run(shown, [{ opacity: 0 }, { opacity: 1 }], fade);
				run(bar, [{ opacity: 0 }, { opacity: 1 }], fade);
				return;
			}
			run(shown, [{ transform: toSource(start, end) }, { transform: "none" }], { duration: OPEN_MS, easing: EASE });
			run(veil, [{ opacity: 0 }, { opacity: 1 }], { duration: OPEN_MS, easing: "ease-out" });
			const late = { duration: OPEN_MS * 0.5, delay: OPEN_MS * 0.5, easing: "linear" };
			run(bar, [{ opacity: 0 }, { opacity: 1 }], late);
			for (const el of chrome) run(el, [{ opacity: 0 }, { opacity: 1 }], late);
		}

		function close() {
			if (!dialog!.open || closing || !shown || !source) return;
			closing = true;

			// Start from wherever things are now, so a close during the opening move
			// reverses smoothly instead of jumping.
			const now = (el: Element, prop: "transform" | "opacity") => getComputedStyle(el)[prop];
			const from = {
				transform: now(shown, "transform"),
				veil: now(veil, "opacity"),
				bar: now(bar, "opacity"),
				chrome: chromeOf(shown).map((el) => now(el, "opacity")),
				shown: now(shown, "opacity"),
			};
			const chrome = chromeOf(shown);
			for (const a of running) a.cancel();
			running = [];

			if (reduced.matches) {
				const fade = { duration: 120, easing: "linear" };
				run(veil, [{ opacity: from.veil }, { opacity: 0 }], fade);
				run(shown, [{ opacity: from.shown }, { opacity: 0 }], fade);
				run(bar, [{ opacity: from.bar }, { opacity: 0 }], fade);
				setTimeout(finish, 120);
				return;
			}

			const target = source.getBoundingClientRect();
			const home = slot.getBoundingClientRect();
			const visible = target.bottom > 0 && target.top < innerHeight;
			run(shown, [{ transform: from.transform }, { transform: visible ? toSource(target, home) : "none" }], {
				duration: CLOSE_MS,
				easing: EASE,
			});
			run(veil, [{ opacity: from.veil }, { opacity: 0 }], { duration: CLOSE_MS, easing: "ease-out" });
			const quick = { duration: CLOSE_MS * 0.4, easing: "linear" };
			run(bar, [{ opacity: from.bar }, { opacity: 0 }], quick);
			chrome.forEach((el, i) => run(el, [{ opacity: from.chrome[i] }, { opacity: 0 }], quick));
			if (!visible) run(shown, [{ opacity: from.shown }, { opacity: 0 }], { duration: CLOSE_MS, easing: "linear" });
			setTimeout(finish, CLOSE_MS);
		}

		function finish() {
			if (!shown && !source) return;
			for (const a of running) a.cancel();
			running = [];
			if (dialog!.open) dialog!.close();
			shown?.remove();
			slot.replaceChildren();
			shown = null;
			document.documentElement.classList.remove("lightbox-open");

			if (source) {
				source.style.visibility = "";
				// The hairlines draw back in on the page, as they drew in on the way out.
				if (!reduced.matches) {
					for (const el of chromeOf(source)) el.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 120, easing: "linear" });
				}
			}
			source = null;
			closing = false;
			if (trigger && document.activeElement === document.body) trigger.focus({ preventScroll: true });
			trigger = null;
		}

		dialog.addEventListener("click", close);
		dialog.addEventListener("cancel", (e) => {
			e.preventDefault(); // Esc: leave through the animation
			close();
		});
		// Closed by the browser some other way: put the page back.
		dialog.addEventListener("close", () => {
			if (shown || source) finish();
		});
		addEventListener("resize", () => {
			if (dialog.open && !closing) fit();
		});

		// Wrap each zoomable picture in a button. A picture that has no script has no button.
		for (const figure of document.querySelectorAll<HTMLElement>("figure[data-zoom]")) {
			const pic = figure.querySelector<HTMLElement>(".pic");
			if (!pic) continue;
			const label = figure.querySelector("figcaption .mono")?.textContent?.trim();
			const button = document.createElement("button");
			button.type = "button";
			button.className = "zoom";
			button.setAttribute("aria-haspopup", "dialog");
			button.setAttribute("aria-label", label ? `Enlarge ${label}` : "Enlarge image");
			pic.replaceWith(button);
			button.append(pic);
			button.addEventListener("click", () => open(button, figure));
		}
	}
</script>
