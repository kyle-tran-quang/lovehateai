---
interface Props {
	links: { href: string; label: string }[];
	// "full" runs the rule edge to edge. "right" runs it under the links only
	// (columns 4-6 of six), as the article pattern asks.
	rule?: "full" | "right";
	// Keeps the bar at the top of the window while the page scrolls under it. From 48rem
	// up only: on phones the links wrap onto several lines and would cover too much.
	// A page that sets it also sets `scroll-padding-top`, so jumps and focus land clear
	// of the bar.
	sticky?: boolean;
	// The column (of 12) where the links start from 64rem up. 5 is where the section
	// bodies on the homepage and the library pages start. The article pattern asks for 7
	// (column 4 of six), so the article pages set it.
	navStart?: number;
	// A magnifier at the right end of the bar, linking to /search/. For a page whose
	// links don't already include Search.
	search?: boolean;
}

const { links, rule = "full", sticky = false, navStart = 5, search = false } = Astro.props;
---

<a class="skip" href="#main">Skip to content</a>
<header class:list={["grid bar", { right: rule === "right", sticky, withSearch: search }]} style={`--nav-start: ${navStart}`}>
	<a class="wordmark" href="/">Love&amp;Hate AI</a>
	{
		links.length > 0 && (
			<nav aria-label="Sections">
				<ul role="list">
					{links.map((link) => (
						<li>
							<a href={link.href}>{link.label}</a>
						</li>
					))}
				</ul>
			</nav>
		)
	}
	{
		search && (
			<a class="find" href="/search/" aria-label="Search the site">
				<svg viewBox="0 0 20 20" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false">
					<circle cx="8.5" cy="8.5" r="5.75" />
					<path d="M12.75 12.75 18 18" />
				</svg>
			</a>
		)
	}
	<hr />
</header>

<style>
	.skip:not(:focus) {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}

	.skip {
		display: block;
		padding: var(--line) var(--margin) 0;
	}

	.bar {
		padding-top: var(--line);
		row-gap: var(--line);
		align-items: baseline;
	}

	.wordmark {
		font-weight: 700;
	}

	.find {
		display: flex;
		justify-content: flex-end;
		align-items: center;
		justify-self: end;
		min-width: 1.5rem;
		min-height: 1.5rem;
	}

	nav ul {
		display: flex;
		flex-wrap: wrap;
		gap: 0 var(--gutter);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	/* Phones: each link is at least 24px tall (WCAG 2.5.8), so wrapped lines don't
	   crowd each other. */
	@media (max-width: 47.999rem) {
		.bar {
			row-gap: calc(var(--line) * 0.25);
		}

		nav a {
			display: inline-block;
			padding-block: 0.3rem;
		}

		.wordmark {
			display: inline-block;
			padding-block: 0.3rem;
			justify-self: start;
		}

		/* The icon shares the wordmark's row at the right. Both are placed explicitly,
		   because auto placement would push the icon below the links. */
		.withSearch .wordmark,
		.find {
			grid-row: 1;
			grid-column: 1;
		}
	}

	@media (min-width: 48rem) {
		/* The bar is as wide as the content under it, so its own ground covers it. */
		.sticky {
			position: sticky;
			top: 0;
			z-index: 10;
			background: var(--page);
		}

		.wordmark {
			grid-column: 1 / span 4;
		}

		nav {
			grid-column: 5 / -1;
		}

		/* The icon takes the last column, and the links stop short of it. */
		.withSearch nav {
			grid-column: 5 / -2;
		}

		.find {
			grid-column: -2 / -1;
		}

		hr {
			grid-column: 1 / -1;
		}
	}

	/* Links start at `navStart`, column 5 of 12 unless the page moves them. */
	@media (min-width: 64rem) {
		.wordmark {
			grid-column: 1 / span 2;
		}

		nav {
			grid-column: var(--nav-start) / -1;
		}

		.withSearch nav {
			grid-column: var(--nav-start) / -2;
		}

		.right hr {
			grid-column: var(--nav-start) / -1;
		}
	}
</style>
