---
interface Props {
	links: { href: string; label: string }[];
	// "full" runs the rule edge to edge. "right" runs it under the links only
	// (columns 4-6 of six), as the article pattern asks.
	rule?: "full" | "right";
	// Keeps the bar at the top of the window while the page scrolls under it. From 48rem
	// up only: on phones the links wrap onto several lines and would cover too much.
	// A page that sets it also sets `scroll-padding-top`, so jumps and focus land clear
	// of the bar.
	sticky?: boolean;
}

const { links, rule = "full", sticky = false } = Astro.props;
---

<a class="skip" href="#main">Skip to content</a>
<header class:list={["grid bar", { right: rule === "right", sticky }]}>
	<a class="wordmark" href="/">Love&amp;Hate AI</a>
	{
		links.length > 0 && (
			<nav aria-label="Sections">
				<ul role="list">
					{links.map((link) => (
						<li>
							<a href={link.href}>{link.label}</a>
						</li>
					))}
				</ul>
			</nav>
		)
	}
	<hr />
</header>

<style>
	.skip:not(:focus) {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}

	.skip {
		display: block;
		padding: var(--line) var(--margin) 0;
	}

	.bar {
		padding-top: var(--line);
		row-gap: var(--line);
		align-items: baseline;
	}

	.wordmark {
		font-weight: 700;
	}

	nav ul {
		display: flex;
		flex-wrap: wrap;
		gap: 0 var(--gutter);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	/* Phones: each link is at least 24px tall (WCAG 2.5.8), so wrapped lines don't
	   crowd each other. */
	@media (max-width: 47.999rem) {
		.bar {
			row-gap: calc(var(--line) * 0.25);
		}

		nav a {
			display: inline-block;
			padding-block: 0.3rem;
		}

		.wordmark {
			display: inline-block;
			padding-block: 0.3rem;
			justify-self: start;
		}
	}

	@media (min-width: 48rem) {
		/* The bar is as wide as the content under it, so its own ground covers it. */
		.sticky {
			position: sticky;
			top: 0;
			z-index: 10;
			background: var(--page);
		}

		.wordmark {
			grid-column: 1 / span 4;
		}

		nav {
			grid-column: 5 / -1;
		}

		hr {
			grid-column: 1 / -1;
		}
	}

	/* Links start in column 4 of the six-column pattern, which is column 7 of 12. */
	@media (min-width: 64rem) {
		.wordmark {
			grid-column: 1 / span 2;
		}

		nav {
			grid-column: 7 / -1;
		}

		.right hr {
			grid-column: 7 / -1;
		}
	}
</style>
